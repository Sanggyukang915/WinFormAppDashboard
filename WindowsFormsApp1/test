using System;
using System.Collections.Generic;
using System.Data;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;
using WindowsFormsApp1.UI;

namespace WindowsFormsApp1
{
    internal class Page1
    {
        private readonly Form _mainForm;
        private readonly DBConnect dbconn = new DBConnect();
        private DataTable pointInfos = new DataTable();
        public Panel pnlMain;

        public Page1(Form mainForm)
        {
            _mainForm = mainForm;

            if (!dbconn.GetData(query, pointInfos))
                return;
        }

        public void BuildPage()
        {
            pnlMain = new Panel { Dock = DockStyle.Fill, BackColor = AppColor.BgDeep };

            TableLayoutPanel tblMain = new TableLayoutPanel
            {
                Dock = DockStyle.Fill,
                RowCount = 1,
                ColumnCount = 2,
                Padding = new Padding(0, 46, 0, 28),
                CellBorderStyle = TableLayoutPanelCellBorderStyle.None,
            };
            tblMain.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 200));
            tblMain.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100));

            FlowLayoutPanel pnlStationMenu = BuildStationMenu();
            tblMain.Controls.Add(pnlStationMenu, 0, 0);

            TableLayoutPanel pnlStationDetail = BuildStationDetail();
            tblMain.Controls.Add(pnlStationDetail, 1, 0);

            pnlMain.Controls.Add(tblMain);
            _mainForm.Controls.Add(pnlMain);
        }

        private FlowLayoutPanel BuildStationMenu()
        {
            FlowLayoutPanel pnlStationMenu = new FlowLayoutPanel { Dock = DockStyle.Fill, BackColor = AppColor.BgPanel, FlowDirection = FlowDirection.TopDown, WrapContents = true };

            pnlStationMenu.Paint += (s, e) =>
            {
                using (var pen = new Pen(Color.FromArgb(25, 255, 255, 255)))
                    e.Graphics.DrawRectangle(pen, 0, 0,
                                               pnlStationMenu.Width - 1, pnlStationMenu.Height - 1);
            };
            pnlStationMenu.Resize += (s, e) => pnlStationMenu.Invalidate();
            if (pointInfos.Rows.Count > 0)
            {
                var groupData = from row in pointInfos.AsEnumerable()
                                group row by row.Field<string>("LineName") into g
                                select new
                                {
                                    LineName = g.Key,
                                    Rows = g.ToList(),
                                    Count = g.Count(),
                                };
                int menuCount = groupData.Count();
                foreach (var group in groupData)
                {
                    CustomCard card = new CustomCard(group.LineName.ToString(), AppColor.BgCard);
                    int itemY = 0;
                    foreach (var row in group.Rows)
                    {
                        Label items = new Label
                        {
                            Location = new Point(0, itemY),
                            Size = new Size(171, 16),
                            Text = row["SysName"].ToString(),
                            Font = new Font("Segoe UI",9f),
                            BackColor = Color.Transparent,
                        };
                        itemY += 17;
                        card.AddControl(items);
                    }
                    pnlStationMenu.Controls.Add(card.CardPanel);
                }
            }

            return pnlStationMenu;
        }
        private TableLayoutPanel BuildStationDetail()
        {
            TableLayoutPanel tblDetail = new TableLayoutPanel
            {
                Dock = DockStyle.Fill,
                RowCount = 1,
                ColumnCount = 2,
                CellBorderStyle = TableLayoutPanelCellBorderStyle.None,
            };

            tblDetail.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 50f));
            tblDetail.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 50f));

            Panel pnlSysDetail = new Panel { Dock = DockStyle.Fill, BackColor = AppColor.BgCard };
            pnlSysDetail.Paint += (s, e) =>
            {
                PaintCard(e.Graphics, pnlSysDetail, "System Detail", false);
            };
            pnlSysDetail.Resize += (s, e) => pnlSysDetail.Invalidate();
            tblDetail.Controls.Add(pnlSysDetail, 1, 0);

            Panel pnlJobDetail = new Panel { Dock = DockStyle.Fill, BackColor = AppColor.BgCard }; ;
            pnlJobDetail.Paint += (s, e) =>
            {
                PaintCard(e.Graphics, pnlJobDetail, "Job Detail", false);
            };

            pnlJobDetail.Resize += (s, e) => pnlJobDetail.Invalidate();
            tblDetail.Controls.Add(pnlJobDetail, 0, 0);


            return tblDetail;
        }

        private void DrawTextRow(Graphics g, int W, int y, string label, string val, Color col)
        {
            using (var f = new Font("Segoe UI", 8.5f))
            using (var br = new SolidBrush(AppColor.TextSecondary))
                g.DrawString(label, f, br, 10, y);
            using (var f = new Font("Consolas", 9.5f, FontStyle.Bold))
            using (var br = new SolidBrush(col))
            {
                var sf = new StringFormat { Alignment = StringAlignment.Far };
                g.DrawString(val, f, br, new RectangleF(0, y, W - 10, 20), sf);
            }
            using (var pen = new Pen(Color.FromArgb(8, 255, 255, 255)))
                g.DrawLine(pen, 10, y + 20, W - 10, y + 20);
        }

        private string getDataField(DataTable dt,string id)
        {
            return dt.Rows[0][id] == null || dt.Rows[0][id] == DBNull.Value ? "No Data" : dt.Rows[0][id].ToString();
        }

        private void PaintCard(Graphics g, Panel p, string title, bool hasDropDown)
        {
            g.SmoothingMode = SmoothingMode.AntiAlias;
            using (var pen = new Pen(Color.FromArgb(30, 255, 255, 255)))
                g.DrawRectangle(pen, 0, 0, p.Width - 1, p.Height - 1);
            using (var br = new SolidBrush(Color.FromArgb(20, 255, 255, 255)))
                g.FillRectangle(br, 0, 0, p.Width, 24);
            using (var pen = new Pen(Color.FromArgb(25, 255, 255, 255)))
                g.DrawLine(pen, 0, 24, p.Width, 24);
            using (var br = new SolidBrush(AppColor.Accent))
                g.FillEllipse(br, 8, 10, 4, 4);
            using (var f = new Font("Consolas", 7.5f, FontStyle.Bold))
            using (var br = new SolidBrush(AppColor.TextPrimary))
                g.DrawString(title.ToUpper(), f, br, 16, 7);
            if (hasDropDown)
            {
                using (var br = new SolidBrush(AppColor.Accent))
                    g.FillPolygon(br, new Point[] { new Point(p.Width - 16, 8), new Point(p.Width - 8, 8), new Point(p.Width - 12, 16) });
            }
        }
    }
}
